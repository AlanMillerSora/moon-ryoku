{
  "id": "moon-phase",
  "name": "Moon Phase",
  "version": "0.1.0",
  "author": "Alan Miller <260780583+AlanMillerSora@users.noreply.github.com>",
  "description": "Фаза Луны в баре: серп по текущей фазе и процент освещённости. Считается локально по эклиптическим долготам, без сети.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 300
  },
  "files": [
    "assets/preview-widget.png",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "capabilities": {
    "densities": [
      "glyph",
      "compact"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "label": "Moon Phase",
    "icon": "dark_mode",
    "bar": {
      "section": "right"
    }
  },
  "dependencies": {
    "commands": []
  },
  "metadata": {
    "settings": [
      {
        "key": "showPercent",
        "type": "toggle",
        "label": "Show the illuminated percent",
        "group": "Moon Phase",
        "default": true
      }
    ]
  },
  "upstream": "https://github.com/AlanMillerSora/moon-ryoku/tree/main/plugins/moon-phase"
}
