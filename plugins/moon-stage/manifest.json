{
  "id": "moon-stage",
  "name": "Moon Stage",
  "version": "0.1.0",
  "author": "Alan Miller <260780583+AlanMillerSora@users.noreply.github.com>",
  "description": "Луна на сцене: серп текущей фазы, процент, возраст и следующее полнолуние прямо на обоях. Считается локально, окно не создаёт — живёт в слое виджетов Ryoku.",
  "license": "MIT",
  "official": false,
  "upstream": "https://github.com/AlanMillerSora/moon-ryoku/tree/main/plugins/moon-stage",
  "hosts": [
    "desktopWidget"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "assets/preview-widget.png",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "capabilities": {
    "densities": [
      "compact"
    ]
  },
  "defaults": {
    "host": "desktopWidget",
    "label": "Moon Stage",
    "icon": "nightlight",
    "desktopWidget": {
      "x": 2528,
      "y": 760,
      "scale": 1
    }
  },
  "dependencies": {
    "commands": []
  },
  "metadata": {
    "settings": [
      {
        "key": "showDetails",
        "type": "toggle",
        "label": "Show the age and the next full moon",
        "group": "Moon Stage",
        "default": true
      }
    ]
  }
}
