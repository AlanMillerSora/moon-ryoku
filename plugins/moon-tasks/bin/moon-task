#!/usr/bin/env bash
# moon-task — задачи для виджета moon-tasks. Пишет только в переданный каталог
# состояния (его даёт виджет через pluginApi.stateDir), без сети и без sudo.
# Один писатель: все изменения идут под flock, поэтому двойной клик не теряется.
#
#   moon-task ~/.local/state/ryoku/plugins/moon-tasks add "позвонить в банк"
#   moon-task <dir> list
#   moon-task <dir> toggle 3
#   moon-task <dir> done 3        (идемпотентно)
#   moon-task <dir> clear         (убрать выполненные)
set -euo pipefail

state="${1:?нужен каталог состояния (pluginApi.stateDir)}"
cmd="${2:?нужна команда: add|list|toggle|done|clear}"
shift 2

file="$state/tasks.json"
mkdir -p "$state"
exec 9>"$state/.lock"
flock -x 9

# чини только пустой и битый файл: битый уводим в карантин, чтобы виджет ожил
if [ ! -s "$file" ]; then
  printf '[]\n' > "$file"
elif ! jq -e 'type == "array"' "$file" >/dev/null 2>&1; then
  mv "$file" "$file.broken-$(date +%s)"
  printf '[]\n' > "$file"
  echo "moon-task: битый tasks.json убран в карантин, список начат заново" >&2
fi

case "$cmd" in
  add)
    text="${*:-}"
    [ -n "$text" ] || { echo "moon-task add: нужен текст" >&2; exit 2; }
    jq --arg t "$text" --argjson ts "$(date +%s)" \
      '. + [{id: ((map(.id) | max) // 0) + 1, text: $t, done: false, at: $ts}]' \
      "$file" > "$file.new" && mv "$file.new" "$file"
    ;;
  toggle)
    id="${1:?id}"
    jq --argjson id "$id" 'map(if .id == $id then .done = (.done | not) else . end)' \
      "$file" > "$file.new" && mv "$file.new" "$file"
    ;;
  done)
    id="${1:?id}"
    jq --argjson id "$id" 'map(if .id == $id then .done = true else . end)' \
      "$file" > "$file.new" && mv "$file.new" "$file"
    ;;
  clear)
    jq '[.[] | select(.done | not)]' "$file" > "$file.new" && mv "$file.new" "$file"
    ;;
  list)
    jq -r '.[] | "\(if .done then "☾" else "☽" end) \(.id). \(.text)"' "$file"
    ;;
  *)
    echo "usage: moon-task <dir> add <текст> | list | toggle <id> | done <id> | clear" >&2
    exit 2
    ;;
esac
