{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/ryoku-logo.png",
    "width": 32,
    "height": 14,
    "padding": {
      "left": 3,
      "right": 5,
      "top": 5
    }
  },
  "display": {
    "color": {
      "keys": "38;2;231;233;238",
      "separator": "38;2;166;166;174",
      "title": "38;2;244;244;246"
    },
    "key": {
      "width": 9
    },
    "percent": {
      "color": {
        "green": "38;2;158;162;171",
        "red": "38;2;168;72;64",
        "yellow": "38;2;201;203;210"
      },
      "type": 9
    },
    "separator": "  "
  },
  "modules": [
    "break",
    {
      "format": "{#1;title}{user-name}{#}{#separator} @ {#}{#1;title}{host-name}{#}",
      "type": "title"
    },
    {
      "format": "\u001b[38;2;231;233;238m■\u001b[0m \u001b[38;2;166;166;174m{#keys}■{#} {#separator}RYOKU · 力 · a hand-built Linux desktop{#}\u001b[0m",
      "type": "custom"
    },
    "break",
    {
      "format": "\u001b[38;2;231;233;238m──\u001b[0m \u001b[1;38;2;244;244;246m{#keys}──{#} {#1;title}VITALS{#} {#38;2;128;128;130}──────────────────────────{#}\u001b[0m \u001b[38;2;128;128;130m────\u001b[0m",
      "type": "custom"
    },
    {
      "key": "CPU",
      "type": "cpu"
    },
    {
      "detectionMethod": "pci",
      "key": "GPU",
      "type": "gpu"
    },
    {
      "key": "MEMORY",
      "type": "memory"
    },
    {
      "key": "DISK",
      "type": "disk"
    },
    "break",
    {
      "format": "\u001b[38;2;231;233;238m──\u001b[0m \u001b[1;38;2;244;244;246m{#keys}──{#} {#1;title}SYSTEM{#} {#38;2;128;128;130}──────────────────────────{#}\u001b[0m \u001b[38;2;128;128;130m────\u001b[0m",
      "type": "custom"
    },
    {
      "key": "OS",
      "type": "os"
    },
    {
      "key": "KERNEL",
      "type": "kernel"
    },
    {
      "key": "WM",
      "type": "wm"
    },
    {
      "key": "SHELL",
      "type": "shell"
    },
    {
      "key": "PKGS",
      "type": "packages"
    },
    "break",
    {
      "format": "\u001b[38;2;231;233;238m──\u001b[0m \u001b[1;38;2;244;244;246m{#keys}──{#} {#1;title}SESSION{#} {#38;2;128;128;130}─────────────────────────{#}\u001b[0m \u001b[38;2;128;128;130m────\u001b[0m",
      "type": "custom"
    },
    {
      "key": "UPTIME",
      "type": "uptime"
    },
    {
      "key": "TERM",
      "type": "terminal"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    },
    "break"
  ]
}
